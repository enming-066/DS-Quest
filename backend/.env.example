# 复制这个文件为 backend/.env，然后按需修改。
# .env 已经在 .gitignore 里，不会被提交到 GitHub。

# ---- DeepSeek（不填也能用，只是没有 AI 助教）----
DEEPSEEK_API_KEY=
# 想省钱可以把上限调小；想放开就调大
DSQ_AI_DAILY_LIMIT=30
# 单次回答的最大 token 数
DSQ_AI_MAX_TOKENS=1200
DEEPSEEK_MODEL=deepseek-chat
# 如果你的网络需要走代理，可以改这里
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 服务 ----
DSQ_HOST=127.0.0.1
DSQ_PORT=8000

# ---- 判题 ----
# 不填会自动在 PATH 里找 g++ / gcc；找不到就写完整路径
# DSQ_COMPILER=D:\TDM-GCC-64\bin\g++.exe
# DSQ_C_COMPILER=D:\TDM-GCC-64\bin\gcc.exe
DSQ_TIME_LIMIT_MS=2000
DSQ_MEMORY_LIMIT_MB=256
